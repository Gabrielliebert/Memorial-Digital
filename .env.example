# ═════════════════════════════════════════════════════════════════
# Configuração do Memorial Digital
# Copie este arquivo para .env e preencha
# ═════════════════════════════════════════════════════════════════

# ── Backend de IA ────────────────────────────────────────────────
# Opções: "gemini" (recomendado, gratuito) ou "ollama" (local/Colab)
LLM_PROVIDER=gemini

# ── Gemini API (RECOMENDADO) ─────────────────────────────────────
# Pegue sua chave gratuita em: https://aistudio.google.com/apikey
# Tier gratuito: 15 requisições/min, suficiente para uso normal.
# Modelos sugeridos:
#   - gemini-2.0-flash-exp     (recomendado, rápido e gratuito)
#   - gemini-1.5-flash         (estável, gratuito)
#   - gemini-1.5-pro           (mais lento, melhor qualidade)
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.0-flash-exp

# ── Ollama (alternativa local/Colab) ─────────────────────────────
# Use APENAS se não tiver chave Gemini.
# IMPORTANTE: NÃO use qwen3 (modelo de raciocínio, gera texto ruim).
# Modelos sugeridos para o memorial:
#   - llama3.1:8b       (recomendado, equilibra qualidade e tamanho)
#   - mistral:7b        (bom para pt-BR, leve)
#   - gemma2:9b         (Google open, qualidade boa)
#   - llama3.3:70b      (excelente mas exige GPU forte)
OLLAMA_BASE_URL=https://abc123.ngrok-free.app
OLLAMA_MODEL=llama3.1:8b

# ── Geração ──────────────────────────────────────────────────────
# Temperatura: 0.0 = determinístico, 1.0 = criativo
# Para memorial: 0.3-0.5 é ideal (algum estilo sem alucinação)
LLM_TEMPERATURE=0.4

# ── Escavador (opcional) ─────────────────────────────────────────
# API que processa Lattes e retorna JSON estruturado — sem CAPTCHA.
# Útil quando você não quer abrir o Chromium.
# Obter chave em: https://api.escavador.com/
ESCAVADOR_API_KEY=

# ── Flask ────────────────────────────────────────────────────────
SECRET_KEY=mude-isto-em-producao
FLASK_DEBUG=True
